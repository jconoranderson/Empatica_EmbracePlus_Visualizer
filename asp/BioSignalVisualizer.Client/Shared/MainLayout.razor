@inherits LayoutComponentBase

<MudThemeProvider Theme="_customTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Color="Color.Primary" Elevation="1">
        <MudText Typo="Typo.h5" Class="ml-2" Style="color: rgba(255,255,255,1); opacity: 1; font-weight: 600;">Bio-Signal Visualizer</MudText>
        <MudSpacer />
    </MudAppBar>
    <MudMainContent Class="pa-4 pa-sm-6" Style="background-color: var(--mud-palette-background-grey);">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private MudTheme _customTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
