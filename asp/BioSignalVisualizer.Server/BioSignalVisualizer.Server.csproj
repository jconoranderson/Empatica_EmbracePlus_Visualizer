<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile Condition="'$(ServerPublishSingleFile)'!=''">$(ServerPublishSingleFile)</PublishSingleFile>
    <PublishTrimmed Condition="'$(ServerPublishTrimmed)'!=''">$(ServerPublishTrimmed)</PublishTrimmed>
    <SelfContained Condition="'$(ServerSelfContained)'!=''">$(ServerSelfContained)</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Blazor-ApexCharts" Version="6.0.2" />
    <PackageReference Include="CsvHelper" Version="30.0.1" />
    <PackageReference Include="QuestPDF" Version="2024.3.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.7" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.7" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BioSignalVisualizer.Shared/BioSignalVisualizer.Shared.csproj" />
    <ProjectReference Include="../BioSignalVisualizer.Client/BioSignalVisualizer.Client.csproj" />
  </ItemGroup>
</Project>
