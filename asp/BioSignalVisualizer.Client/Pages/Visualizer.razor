@page "/"
@inject CatalogClient Catalogs
@inject MetricsClient Metrics
@inject AnnotationsClient Annotations
@inject ActivityClient Activity
@inject PdfClient Pdfs
@inject Blazored.LocalStorage.ILocalStorageService Storage
@inject ISnackbar Snackbar
@using Microsoft.JSInterop

<PageTitle>Bio-Signal Visualizer</PageTitle>

<MudGrid Class="mt-4">
    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6">Data Selection</MudText>
            <MudSelect T="string" @bind-Value="SelectedDate" Label="Date" Immediate="true" id="dateselect">
                @foreach (var date in _dates)
                {
                    <MudSelectItem Value="@date">@date</MudSelectItem>
                }
            </MudSelect>
            @if (_compareMode)
            {
                <MudSelect T="string"
                           MultiSelection="true"
                           @bind-SelectedValues="SelectedParticipants"
                           Label="Participants"
                           Disabled="string.IsNullOrEmpty(_selectedDate)"
                           Immediate="true"
                           id="participantselect">
                    @foreach (var participant in _participants)
                    {
                        <MudSelectItem Value="@participant">@GetParticipantDisplayName(participant)</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudSelect T="string"
                           Value="SelectedParticipants.FirstOrDefault()"
                           ValueChanged="OnSingleParticipantChanged"
                           Label="Participant"
                           Disabled="string.IsNullOrEmpty(_selectedDate)"
                           Immediate="true"
                           id="participantselect">
                    @foreach (var participant in _participants)
                    {
                        <MudSelectItem Value="@participant">@GetParticipantDisplayName(participant)</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudSelect T="string"
                       MultiSelection="true"
                       @bind-SelectedValues="SelectedMetrics"
                       Label="Metric"
                       Disabled="!_selectedParticipants.Any()"
                       id="metricselect">
                <MudSelectItem Value="@DefaultMetricsToken">Default metrics</MudSelectItem>
                <MudSelectItem Value="@AllMetricsToken">All metrics</MudSelectItem>
                @foreach (var metric in _metrics)
                {
                    <MudSelectItem Value="@metric">@MetricChart.GetDisplayName(metric)</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Chart height</MudText>
            <MudSlider Value="_chartHeight"
                       ValueChanged="@((double value) => OnChartHeightChanged(value))"
                       Min="120"
                       Max="420"
                       Step="20"
                       Immediate="true"
                       id="chartheightslider" />
            <MudSwitch T="bool" @bind-Value="ShowActivityLabels" Color="Color.Primary" Label="Show Activity" Class="mt-2" />
            <MudSwitch T="bool" @bind-Value="_enableReordering" Color="Color.Secondary" Label="Reorder Charts" Class="mt-2" />
            <MudSwitch T="bool" @bind-Value="CompareMode" Color="Color.Tertiary" Label="Compare" Class="mt-2" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DownloadPdf" Disabled="_series.Count == 0" Class="mt-2 text-nowrap">Download PDF</MudButton>
        </MudPaper>

        @if (_selectedParticipants.Count() <= 1)
        {
            <MudPaper Class="pa-4 mt-4" Elevation="1">
                <AnnotationPanel Annotations="_annotations"
                                  SelectedDate="@_selectedDate"
                                  SelectedParticipant="@_selectedParticipants.FirstOrDefault()"
                                  DisplayedMetrics="@(_series.Select(s => s.Metric))"
                                  AvailableTimes="_availableTimepoints"
                                  OnAnnotationsChanged="HandleAnnotationsChanged" />
            </MudPaper>
        }
    </MudItem>
    <MudItem xs="12" md="9" Class="charts-container">
        @if (_enableReordering)
        {
            <MudDropContainer @ref="_dropContainer" T="MetricSeries" Items="@_series" ItemsSelector="@((item,dropzone) => true)" ItemDropped="ItemUpdated" Class="d-flex flex-column gap-4">
                <ChildContent>
                    <MudDropZone T="MetricSeries" Identifier="charts" Class="flex-grow-1" AllowReorder="true" />
                </ChildContent>
                <ItemRenderer>
                    @if (CompareMode && IsFirstOfParticipant(context))
                    {
                        <MudPaper Class="pa-2 mt-4 mb-2" Elevation="0" Style="background-color: var(--mud-palette-background-grey); border-left: 4px solid var(--mud-palette-tertiary);">
                            <MudText Typo="Typo.h6" Class="fw-bold">Participant: @context.Participant</MudText>
                        </MudPaper>
                    }
                    <div style="position: relative;">
                        <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; z-index: 20; background-color: rgba(128,128,128,0.1); cursor: grab; display: flex; align-items: center; justify-content: center; border: 2px dashed var(--mud-palette-secondary); border-radius: 4px;">
                            <MudChip T="string" Color="Color.Secondary" Icon="@Icons.Material.Filled.DragIndicator">Drag to Reorder</MudChip>
                        </div>
                        <div style="pointer-events: none;">
                            <MetricChart Metric="context"
                                         Height="_chartHeight"
                                         Annotations="GetAnnotationsForChart(context.Participant)"
                                         ActivityWindows="_activityWindows"
                                         ShowActivityLabels="ShowActivityLabels"
                                         SyncMinX="_syncMin"
                                         SyncMaxX="_syncMax" />
                        </div>
                    </div>
                </ItemRenderer>
            </MudDropContainer>
        }
        else
        {
            <div class="d-flex flex-column gap-0">
                @foreach (var metric in _series)
                {
                    @if (CompareMode && IsFirstOfParticipant(metric))
                    {
                        <MudPaper Class="pa-2 mt-4 mb-2" Elevation="0" Style="background-color: var(--mud-palette-background-grey); border-left: 4px solid var(--mud-palette-tertiary);">
                            <MudText Typo="Typo.h6" Class="fw-bold">Participant: @GetParticipantDisplayName(metric.Participant)</MudText>
                        </MudPaper>
                    }
                    <MetricChart Metric="metric"
                                 Height="_chartHeight"
                                 Annotations="GetAnnotationsForChart(metric.Participant)"
                                 ActivityWindows="_activityWindows"
                                 ShowActivityLabels="ShowActivityLabels"
                                 SyncMinX="_syncMin"
                                 SyncMaxX="_syncMax" />
                }
            </div>
        }
    </MudItem>
</MudGrid>

@code {
    private const string DefaultMetricsToken = "__DEFAULT_METRICS__";
    private const string AllMetricsToken = "__ALL_METRICS__";
    private const double DefaultChartHeight = 160;
    private static readonly string[] DefaultMetricOrder =
    {
        "eda",
        "actigraphy-counts",
        "pulse-rate",
        "temperature"
    };
    private List<CatalogEntry> _catalogEntries = new();
    private List<string> _dates = new();
    private List<string> _participants = new();
    private List<string> _metrics = new();

    private string? _selectedDate;
    private IEnumerable<string> _selectedParticipants = new HashSet<string>();
    private IEnumerable<string> _selectedMetrics = new HashSet<string> { DefaultMetricsToken };

    private MudDropContainer<MetricSeries>? _dropContainer;
    private readonly List<MetricSeries> _series = new();
    private List<AnnotationEntry> _annotations = new();
    private List<DateTime> _availableTimepoints = new();
    private List<ActivityWindow> _activityWindows = new();
    private DateTime? _syncMin;
    private DateTime? _syncMax;

    private double _chartHeight = DefaultChartHeight;
    private bool _userChartHeightLocked;
    
    private bool _showActivityLabels = false;
    private bool ShowActivityLabels
    {
        get => _showActivityLabels;
        set
        {
            if (_showActivityLabels != value)
            {
                _showActivityLabels = value;
                StateHasChanged();
                _dropContainer?.Refresh();
            }
        }
    }

    private bool _enableReordering = false;
    private bool _compareMode = false;

    private bool IsFirstOfParticipant(MetricSeries item)
    {
        var index = _series.IndexOf(item);
        if (index <= 0) return true;
        return _series[index - 1].Participant != item.Participant;
    }

    private bool CompareMode
    {
        get => _compareMode;
        set
        {
            if (_compareMode != value)
            {
                _compareMode = value;
                if (!_compareMode)
                {
                    _userChartHeightLocked = false;
                    _selectedMetrics = new HashSet<string> { DefaultMetricsToken };

                    var firstParticipant = _participants.FirstOrDefault();
                    if (firstParticipant is not null)
                    {
                        _selectedParticipants = new HashSet<string> { firstParticipant };
                    }
                    else
                    {
                        _selectedParticipants = new HashSet<string>();
                    }
                    _ = InvokeAsync(async () => await OnParticipantsChanged(_selectedParticipants));
                }
                else if (_compareMode)
                {
                    _chartHeight = 120;
                    _userChartHeightLocked = true;
                    UpdateSyncBounds();
                    _ = InvokeAsync(StateHasChanged);
                }
            }
        }
    }

    private string? SelectedDate
    {
        get => _selectedDate;
        set
        {
            if (_selectedDate == value)
            {
                return;
            }

            _selectedDate = value;
            _ = InvokeAsync(async () => await OnDateChanged(value));
        }
    }

    private IEnumerable<string> SelectedParticipants
    {
        get => _selectedParticipants;
        set
        {
            var valueList = value.ToList();
            if (_selectedParticipants.SequenceEqual(valueList))
            {
                return;
            }

            _selectedParticipants = valueList;
            _ = InvokeAsync(async () => await OnParticipantsChanged(_selectedParticipants));
        }
    }

    private Task OnSingleParticipantChanged(string value)
    {
        if (_selectedParticipants.Count() == 1 && _selectedParticipants.First() == value)
        {
            return Task.CompletedTask;
        }

        _selectedParticipants = new HashSet<string> { value };
        return OnParticipantsChanged(_selectedParticipants);
    }

    private IEnumerable<string> SelectedMetrics
    {
        get => _selectedMetrics;
        set
        {
            var valueList = value.ToList();
            if (_selectedMetrics.SequenceEqual(valueList))
            {
                return;
            }

            _selectedMetrics = valueList;
            _ = InvokeAsync(async () => await OnMetricsChanged(_selectedMetrics));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var storedHeight = await Storage.GetItemAsync<double?>("chartHeight");
        if (storedHeight.HasValue)
        {
            _chartHeight = storedHeight.Value;
            _userChartHeightLocked = true;
        }
        else
        {
            _chartHeight = DefaultChartHeight;
        }
        await LoadCatalogAsync();
        _annotations = await Annotations.GetAsync();

        if (_dates.Any())
        {
            await OnDateChanged(_dates.First());
        }
        await SetChartHeightFromViewport();
    }

    private async Task LoadCatalogAsync()
    {
        _catalogEntries = (await Catalogs.GetCatalogAsync()).ToList();
        _dates = _catalogEntries.Select(e => e.Date).Distinct().OrderByDescending(d => d).ToList();
    }

    private async Task OnDateChanged(string? value)
    {
        _selectedDate = value;
        _selectedParticipants = new HashSet<string>();
        _selectedMetrics = new HashSet<string> { DefaultMetricsToken };
        _series.Clear();
        _participants = await GetParticipantsAsync(value);
        _metrics.Clear();

        if (_participants.Any())
        {
            _selectedParticipants = new HashSet<string> { _participants.First() };
            await OnParticipantsChanged(_selectedParticipants);
        }
        else
        {
            _activityWindows = new List<ActivityWindow>();
            UpdateAvailableTimepoints();
            StateHasChanged();
        }
    }

    private async Task OnParticipantsChanged(IEnumerable<string> values)
    {
        _selectedParticipants = values;
        _series.Clear();

        _metrics = GetMetrics(_selectedParticipants.FirstOrDefault());

        if (_selectedParticipants.Count() > 1)
        {
            var edaMetric = _metrics.FirstOrDefault(m => GetMetricSuffix(m).Equals("eda", StringComparison.OrdinalIgnoreCase));
            if (edaMetric != null)
                _selectedMetrics = new HashSet<string> { edaMetric };
            else
                _selectedMetrics = new HashSet<string> { DefaultMetricsToken };
        }
        else if (!_selectedParticipants.Any())
        {
            _selectedMetrics = new HashSet<string> { DefaultMetricsToken };
        }
        else
        {
            var newSelected = new HashSet<string>();
            foreach (var oldMetric in _selectedMetrics)
            {
                if (oldMetric == DefaultMetricsToken || oldMetric == AllMetricsToken)
                {
                    newSelected.Add(oldMetric);
                }
                else
                {
                    var suffix = GetMetricSuffix(oldMetric);
                    var newMetric = _metrics.FirstOrDefault(m => GetMetricSuffix(m).Equals(suffix, StringComparison.OrdinalIgnoreCase));
                    if (newMetric != null) newSelected.Add(newMetric);
                }
            }
            _selectedMetrics = newSelected.Any() ? newSelected : new HashSet<string> { DefaultMetricsToken };
        }

        await LoadActivityWindowsAsync();
        await OnMetricsChanged(_selectedMetrics);
        UpdateAvailableTimepoints();
    }

    private async Task OnMetricsChanged(IEnumerable<string> values)
    {
        _series.Clear();
        if (_selectedDate is null || !_selectedParticipants.Any() || !values.Any())
        {
            UpdateAvailableTimepoints();
            StateHasChanged();
            return;
        }

        var metricsToLoad = new HashSet<string>();

        if (values.Contains(AllMetricsToken))
        {
            foreach (var m in _metrics) metricsToLoad.Add(m);
        }
        else
        {
            if (values.Contains(DefaultMetricsToken))
            {
                foreach (var m in GetDefaultMetricsToDisplay()) metricsToLoad.Add(m);
            }
            foreach (var v in values)
            {
                if (v != DefaultMetricsToken && v != AllMetricsToken)
                {
                    metricsToLoad.Add(v);
                }
            }
        }

        await LoadMetricSeriesAsync(metricsToLoad);

        UpdateAvailableTimepoints();
        StateHasChanged();
        
        // Refresh the drop container so it renders the new items
        _dropContainer?.Refresh();
    }

    private Task<List<string>> GetParticipantsAsync(string? date)
    {
        var participants = string.IsNullOrEmpty(date)
            ? new List<string>()
            : _catalogEntries
                .Where(e => e.Date == date)
                .Select(e => e.Participant)
                .Distinct()
                .OrderBy(p => p)
                .ToList();

        return Task.FromResult(participants);
    }

    private List<string> GetMetrics(string? participant)
    {
        if (_selectedDate is null || string.IsNullOrEmpty(participant))
        {
            return new List<string>();
        }

        return _catalogEntries
            .Where(e => e.Date == _selectedDate && e.Participant == participant)
            .SelectMany(e => e.Metrics)
            .OrderBy(m => m)
            .ToList();
    }

    private async Task HandleAnnotationsChanged(List<AnnotationEntry> updatedAnnotations)
    {
        _annotations = updatedAnnotations;
        await Annotations.SaveAsync(_annotations);
        StateHasChanged();
    }

    private void ItemUpdated(MudItemDropInfo<MetricSeries> dropItem)
    {
        _series.Remove(dropItem.Item);
        _series.Insert(dropItem.IndexInZone, dropItem.Item);
    }

    private async Task DownloadPdf()
    {
        if (_selectedDate is null || !_selectedParticipants.Any() || _series.Count == 0)
        {
            return;
        }

        var annotationSubset = _selectedParticipants.Count() == 1 
            ? _annotations.Where(a => a.Date == _selectedDate && a.Participant == _selectedParticipants.First()).ToList()
            : new List<AnnotationEntry>();
            
        var activitySubset = _showActivityLabels ? _activityWindows : new List<ActivityWindow>();
        var request = new PdfExportRequest(_selectedDate, _selectedParticipants, _series, annotationSubset, activitySubset);
        var bytes = await Pdfs.DownloadSummaryAsync(request);
        var fileName = $"{string.Join("-", _selectedParticipants)}-{_selectedDate}.pdf";
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("BlazorDownloadFile", fileName, "application/pdf", base64);
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private async Task OnChartHeightChanged(double value)
    {
        _chartHeight = value;
        _userChartHeightLocked = true;
        await Storage.SetItemAsync("chartHeight", value);
        StateHasChanged();
        _dropContainer?.Refresh();
    }

    private IEnumerable<string> GetDefaultMetricsToDisplay()
    {
        if (_metrics.Count == 0)
        {
            return Enumerable.Empty<string>();
        }

        var selection = new List<string>();
        foreach (var target in DefaultMetricOrder)
        {
            var match = _metrics.FirstOrDefault(m => MetricMatches(m, target));
            if (match is not null && !selection.Any(m => string.Equals(m, match, StringComparison.OrdinalIgnoreCase)))
            {
                selection.Add(match);
            }
        }

        if (selection.Count > 0)
        {
            return selection;
        }

        return _metrics.Take(Math.Min(4, _metrics.Count));
    }

    private async Task LoadActivityWindowsAsync()
    {
        if (_selectedDate is null || !_selectedParticipants.Any())
        {
            _activityWindows = new List<ActivityWindow>();
            return;
        }

        var windows = new List<ActivityWindow>();
        foreach(var p in _selectedParticipants)
        {
            var pWindows = await Activity.GetWindowsAsync(_selectedDate, p);
            windows.AddRange(pWindows);
        }
        _activityWindows = windows;
    }

    private async Task LoadMetricSeriesAsync(IEnumerable<string> metrics)
    {
        foreach (var p in _selectedParticipants)
        {
            var pMetrics = GetMetrics(p);
            foreach (var metric in metrics)
            {
                var suffix = GetMetricSuffix(metric);
                var actualMetricForP = pMetrics.FirstOrDefault(m => GetMetricSuffix(m).Equals(suffix, StringComparison.OrdinalIgnoreCase));
                
                if (actualMetricForP is not null)
                {
                    var result = await Metrics.GetSeriesAsync(_selectedDate!, p, actualMetricForP);
                    if (result is not null)
                    {
                        _series.Add(result);
                    }
                }
            }
        }
        
        // The order is naturally preserved by the sequential awaits inside the loops above.
        // Grouped by Participant, then ordered by the selection order of metrics.
        UpdateAvailableTimepoints();
        UpdateSyncBounds();
        if (_series.Count > 0)
        {
            await SetChartHeightFromViewport();
        }
    }

    private static bool MetricMatches(string candidate, string target)
    {
        if (string.IsNullOrWhiteSpace(candidate) || string.IsNullOrWhiteSpace(target))
        {
            return false;
        }

        if (candidate.Equals(target, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var suffix = GetMetricSuffix(candidate);
        return suffix.Equals(target, StringComparison.OrdinalIgnoreCase);
    }

    private static string GetMetricSuffix(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return string.Empty;
        }

        var lastUnderscore = name.LastIndexOf('_');
        if (lastUnderscore >= 0 && lastUnderscore < name.Length - 1)
        {
            return name[(lastUnderscore + 1)..];
        }

        return name;
    }

    private IEnumerable<AnnotationEntry> GetAnnotationsForChart(string participantName)
    {
        return _annotations.Where(a => a.Date == _selectedDate && a.Participant == participantName);
    }

    private void UpdateAvailableTimepoints()
    {
        if (_series.Count == 0)
        {
            _availableTimepoints = new List<DateTime>();
            return;
        }

        // An annotation should appear on every chart, so only allow timestamps that
        // are present across all currently displayed metric series.
        var intersection = _series
            .Select(series => series.Points.Select(p => p.Timestamp).ToHashSet())
            .Aggregate((HashSet<DateTime> acc, HashSet<DateTime> next) =>
            {
                acc.IntersectWith(next);
                return acc;
            });

        if (intersection.Count == 0)
        {
            // Fall back to the shared range if the series do not overlap perfectly.
            var min = _series.SelectMany(s => s.Points).Min(p => p.Timestamp);
            var max = _series.SelectMany(s => s.Points).Max(p => p.Timestamp);
            _availableTimepoints = _series
                .SelectMany(s => s.Points)
                .Select(p => p.Timestamp)
                .Where(t => t >= min && t <= max)
                .Distinct()
                .OrderBy(t => t)
                .ToList();
        }
        else
        {
            _availableTimepoints = intersection
                .OrderBy(t => t)
                .ToList();
        }
    }

    private async Task SetChartHeightFromViewport()
    {
        if (_series.Count == 0 || _userChartHeightLocked)
        {
            return;
        }

        try
        {
            var chartCount = Math.Max(1, _series.Count);
            var recommended = await JS.InvokeAsync<double>("metricChart.calculateFitHeight", chartCount);
            var rounded = Math.Round(recommended / 20) * 20;
            var clamped = Math.Clamp(rounded, 120, 420);
            _chartHeight = clamped;
            await Storage.SetItemAsync("chartHeight", _chartHeight);
            StateHasChanged();
            _dropContainer?.Refresh();
        }
        catch (JSException)
        {
            // JS not ready; keep previous value.
        }
    }

    private static string GetParticipantDisplayName(string participant)
    {
        if (string.IsNullOrWhiteSpace(participant)) return participant;
        var dashIndex = participant.IndexOf('-');
        return dashIndex >= 0 ? participant[..dashIndex] : participant;
    }

    private void UpdateSyncBounds()
    {
        if (_series.Count == 0)
        {
            _syncMin = null;
            _syncMax = null;
            return;
        }

        var allPoints = _series.SelectMany(s => s.Points).ToList();
        if (allPoints.Count == 0)
        {
            _syncMin = null;
            _syncMax = null;
            return;
        }

        var minTime = allPoints.Min(p => p.Timestamp);
        var maxTime = allPoints.Max(p => p.Timestamp);

        if (minTime < maxTime)
        {
            _syncMin = minTime;
            _syncMax = maxTime;
            AlignSeriesData();
        }
        else
        {
            _syncMin = null;
            _syncMax = null;
        }
    }

    private void AlignSeriesData()
    {
        if (!_syncMin.HasValue || !_syncMax.HasValue) return;

        var start = _syncMin.Value;
        var end = _syncMax.Value;

        for (int s = 0; s < _series.Count; s++)
        {
            var series = _series[s];
            var originalPoints = series.Points
                .Where(p => !double.IsNaN(p.Value))
                .ToDictionary(p => p.Timestamp, p => p.Value);
                
            var alignedPoints = new List<DataPoint>();

            var current = start;
            while (current <= end)
            {
                if (originalPoints.TryGetValue(current, out var val))
                {
                    alignedPoints.Add(new DataPoint(current, val));
                }
                else
                {
                    alignedPoints.Add(new DataPoint(current, double.NaN));
                }
                current = current.AddMinutes(1);
            }

            _series[s] = series with { Points = alignedPoints };
        }
    }

}
