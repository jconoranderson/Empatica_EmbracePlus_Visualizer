            Background = "#f8fafc",
            Surface = "#ffffff",
            TextPrimary = "#1a202c",
            TextSecondary = "#4a5568",
            DrawerBackground = "#ffffff"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#FF8A65",
            AppbarBackground = "#1A1A27",
            AppbarText = "rgba(255,255,255, 0.90)",
